#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *file;
    int choice;
    char id[50];
    char name[100];
    char section[50];

    // Open student_records.txt in append mode ("a")
    file = fopen("student_records.txt", "a");
    if (file == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    do {
        printf("Enter Student Number: ");
        scanf("%s", id);

        // Clear the input buffer to handle spaces correctly with fgets
        while (getchar() != '\n');

        printf("Enter Complete Name: ");
        fgets(name, sizeof(name), stdin);
        
        // Remove the trailing newline character from fgets if present
        for (int i = 0; name[i] != '\n' && name[i] != '\0'; i++) {
            // keep characters
        }
        // Safely strip newline
        int i = 0;
        while (name[i] != '\0') {
            if (name[i] == '\n') {
                name[i] = '\0';
                break;
            }
            i++;
        }

        printf("Enter Section: ");
        scanf("%s", section);

        // Write the record into student_records.txt
        fprintf(file, "ID Number: %s\n", id);
        fprintf(file, "Complete Name: %s\n", name);
        fprintf(file, "Section: %s\n\n", section);

        printf("Record added and saved successfully.\n");

        printf("Add another student? [Enter 1 for Yes, 0 for No]: ");
        scanf("%d", &choice);

    } while (choice == 1);

    // Close the file
    fclose(file);
    printf("All student records have been saved.\n");

    return 0;
}
